{
  "name": "backend-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun dist/composition/main.js",
    "start:dev": "bun run build && bun run start",
    "test:app": "bun test tests/app",
    "test:domain": "bun test tests/domain",
    "test:smoke": "bun test tests/smoke --timeout 20000",
    "test:persistence": "bun run build && bun test tests/persistence --timeout 30000",
    "db:migrate": "bun run build && bun dist/composition/migrate.js up",
    "db:rollback": "bun run build && bun dist/composition/migrate.js down",
    "db:status": "bun run build && bun dist/composition/migrate.js status",
    "stack:migrate": "docker compose run --rm --build migrate",
    "stack:persistence": "docker compose run --rm --build persistence",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:provision": "bun src/composition/provision-queues.ts",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose --profile workers down",
    "stack:smoke": "docker compose run --rm --build smoke",
    "doctor": "bun scripts/doctor.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "lint": "bun --bun eslint .",
    "format:check": "bun --bun prettier --check .",
    "format": "bun --bun prettier --write .",
    "typecheck": "bun --bun tsc --noEmit",
    "test:harness": "bun test tests/harness",
    "check": "bun scripts/check.ts",
    "start:references": "bun dist/composition/reference-main.js",
    "stack:references": "docker compose --profile workers up --build -d reference-worker",
    "start:consumer": "bun dist/composition/messaging-main.js consumer",
    "start:publisher": "bun dist/composition/messaging-main.js publisher",
    "test:messaging": "bun run build && bun test tests/messaging --timeout 30000",
    "test:distributed": "bun run build && bun test tests/distributed --timeout 45000",
    "stack:messaging": "docker compose run --rm --build messaging",
    "stack:distributed": "docker compose run --rm --build distributed",
    "stack:workers": "docker compose --profile workers up --build -d --wait consumer publisher reference-worker"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.3",
    "@types/markdown-it": "14.1.2",
    "eslint": "9.39.5",
    "markdown-it": "14.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1151.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prometheus-io/client": "0.16.1",
    "ajv": "8.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
